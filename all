/* =========================================================
   🔹 ১৩. tryPlayWithProxies(url)
   ➜ একের পর এক proxy দিয়ে চেষ্টা
   ========================================================= */
async function tryPlayWithProxies(url) {
  for (let proxy of myProxies) {
    let finalUrl = proxy ? proxy + encodeURIComponent(url) : url;
    try {
      await fetch(finalUrl, { method: "GET" });
      play(finalUrl);
      return;
    } catch (e) {}
  }
}





 /* =========================================================

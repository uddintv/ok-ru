async function destroyShakaPlayer() {

    const shakaVideo = document.getElementById("shakaVideo");

    if (shakaPlayer) {
        await shakaPlayer.destroy();
        shakaPlayer = null;
    }

    if (shakaVideo) {
        shakaVideo.pause();
        shakaVideo.removeAttribute("src");
        shakaVideo.load();
        shakaVideo.style.display = "none";
    }
}
  
  
async function refreshMPD() {

    if (isMPDRefreshing) return;

    if (!currentMPDUrl) {
        console.error("MPD URL NOT FOUND");
        return;
    }

    isMPDRefreshing = true;
triggerIntroOverlay();  // ID= INTRO-OVERLAY SHOW IN REFRESH SHAKA PLAYER
  
  
    const url = currentMPDUrl;
    const item = currentMPDManualItem;

    try {

        console.log("MPD REFRESH START");

        await destroyShakaPlayer();

        await playMPD(url, item);

        console.log("MPD REFRESH FINISHED");

    } catch (error) {

        console.error("MPD REFRESH ERROR:", error);

    } finally {

        isMPDRefreshing = false;

    }
}  
  

  
  

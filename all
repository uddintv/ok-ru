    const v = getActiveVideo();

    if (!v.muted && v.volume >= 0.01) {

        lastVolume = v.volume;

        v.muted = true;
        v.volume = 0;

        volume.value = 0;

    } else {

        v.muted = false;

        v.volume = lastVolume >= 0.01 ? lastVolume : 1;

        volume.value = v.volume;

    }

    updateVolumeIcon(v);

});
  
  

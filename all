/* ===============================
   Channel Overlay
   ভিডিওর উপর চ্যানেলের নাম দেখানোর স্টাইল
   =============================== */
.channel-display-overlay {
    position: absolute;
    bottom: 10px; 
    left: 50%; 
    transform: translateX(-50%);
    color: #999;
    background:  rgba(0, 0, 0, 0.0);
    padding: 4px ;
    font-weight: ;
    font-size: 18px;
    z-index: 999;
    display: none; 
    pointer-events: none;
    animation: fadeInOut 4s forwards;  /*  */
  /* নিচের এই ৩টি লাইন যোগ করুন */
    white-space: nowrap;       /* টেক্সটকে ২য় লাইনে যেতে বাধা দেবে */
    overflow: hidden;          /* অতিরিক্ত অংশ লুকিয়ে ফেলবে */

  
}

@keyframes fadeInOut {
    0% { opacity: 0; }   
    10% { opacity: 1; }  
    80% { opacity: 1; }  
    100% { opacity: 0; } 
 }
  
        
/* ===============================
   In-Video Overlay Controls
   =============================== */
.video-overlay {
    position: absolute;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    transition: opacity .3s;
}

.video-overlay.hidden { opacity: 0; }
.video-overlay:not(.hidden) { opacity: 1; }

/* সব বাটন clickable */
.video-overlay button,
.overlay-ch,
.overlay-ch-nav {
    pointer-events: auto;
}

/* NEXT / PREV   */
.overlay-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background:  rgba(255, 255, 255, 0.1); /*  rgba(0,0,0,.0); */
    color: green ;/*yellow  rgba(255, 255, 0,0.1)*/
    font-size: 20px; /* 24px  */
    padding: 13px 8px; /*   5% 14px; */
    /*border-radius: 50%; */
  border: 1px solid rgba(255, 255, 255, 0.3); /*  none; */
  border-radius: 10px;
  backdrop-filter: blur(4px);
  
    cursor: pointer;
    transition: 0.3s;
}

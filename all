/* =========================================================
    🔹 YouTube URL শনাক্ত ও add paramiter in link
   ========================================================= */

function prepareYouTubeUrl(url) {

    if (!url) return url;

    try {
        const u = new URL(url);

        const isYouTube =
            u.hostname === "youtube.com" ||
            u.hostname.endsWith(".youtube.com") ||
            u.hostname === "youtu.be";

        if (!isYouTube) return url;

        // Watch URL থেকে Embed URL
        if (u.pathname === "/watch") {
            const id = u.searchParams.get("v");
            if (id) u.pathname = "/embed/" + id;
        }

        // Short URL থেকে Embed URL
        if (u.hostname === "youtu.be") {
            const id = u.pathname.substring(1);
            u.hostname = "www.youtube.com";
            u.pathname = "/embed/" + id;
        }

        // প্রয়োজনীয় Parameter
        u.searchParams.set("enablejsapi", "1");
        u.searchParams.set("autoplay", "1");
        u.searchParams.set("mute", "0");
        u.searchParams.set("controls", "0");
        u.searchParams.set("playsinline", "1");
        //u.searchParams.set("origin", location.origin);
u.searchParams.set("fs", "0");
u.searchParams.set("disablekb", "1");      
      
      
        return u.toString();

    } catch (e) {
        return url;
    }
}



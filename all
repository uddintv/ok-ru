border: 2px solid #555 ; /*#555 green #000  #475569;  */
border-bottom: 1px solid #555 ;
padding: 0px 10px; 
 align-items: center; 
 gap: 10px; 
 transition: all 0.3s;      
  margin: 8px;  
  cursor: pointer;

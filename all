let shakaPlayer = null;
let currentMPDUrl = "";
let currentMPDManualItem = null;
let isMPDRefreshing = false;
  
async function playMPD(url, manualItem = null) {

currentMPDUrl = url;
currentMPDManualItem = manualItem;
currentPlayerType = "MPD";

    const video = document.getElementById("mainVideo");
    const iframe = document.getElementById("mainIframe");
    const shakaVideo = document.getElementById("shakaVideo");

    try {

        toggleVideoControls(true);

        // পুরোনো HLS বন্ধ
        if (hls) {
            hls.destroy();
            hls = null;
        }

        // পুরোনো Player বন্ধ
        if (shakaPlayer) {
            await shakaPlayer.destroy();
            shakaPlayer = null;
        }

        video.pause();
        video.removeAttribute("src");
        video.load();
        video.style.display = "none";

        iframe.src = "about:blank";
        iframe.style.display = "none";

        shakaVideo.style.display = "block";

shakaVideo.volume = video.volume;
shakaVideo.muted = video.muted;      
      
      
        if (!shaka.Player.isBrowserSupported()) {
            throw new Error("Shaka unsupported");
        }

        // নতুন Shaka Player
        shakaPlayer = new shaka.Player(shakaVideo);
      
 

        // 🔥 **ULTIMATE LAG-FREE & BUFFER-FREE CONFIGURATION shakaPlayer** 🔥
        shakaPlayer.configure({
            streaming: {
                lowLatencyMode: true,

<script>
const overlayWrap = document.getElementById("overlayChannels");
let currentIndex = 0;

/* ===== নাম্বার তৈরি ===== */
function buildOverlayChannels() {
    overlayWrap.innerHTML = "";
    const chBtns = document.querySelectorAll(".ch-item");

    chBtns.forEach((btn, i) => {
        const c = document.createElement("div");
        c.className = "overlay-ch";
        c.textContent = i + 1;

        c.onclick = (e) => {
            e.stopPropagation();
            setActiveLoop(i);   // শুধু click এ চ্যানেল বদলাবে
        };

        overlayWrap.appendChild(c);
    });

    setActiveLoop(0); // প্রথম নাম্বার
}

/* ===== LOOP + ACTIVE ===== */
function setActiveLoop(idx) {
    const nums = overlayWrap.querySelectorAll(".overlay-ch");
    const chBtns = document.querySelectorAll(".ch-item");
    const total = nums.length;

    if (idx < 0) idx = total - 1;
    if (idx >= total) idx = 0;

    currentIndex = idx;

    nums.forEach((n, i) => n.classList.toggle("active", i === idx));

    if (chBtns[idx]) chBtns[idx].click();

    // active নাম্বার CENTER এ
    nums[idx].scrollIntoView({
        behavior: "smooth",
        inline: "center",
        block: "nearest"
    });
}

/* ===== ❮ ❯ শুধু SCROLL করবে ===== */
function scrollChannels(dir) {
    const maxScroll =
        overlayWrap.scrollWidth - overlayWrap.clientWidth;

    // ডানে স্ক্রল
    if (dir > 0) {
        // যদি শেষ এ পৌঁছে যায় → শুরুতে নিয়ে আসো
        if (overlayWrap.scrollLeft >= maxScroll - 5) {
            overlayWrap.scrollTo({ left: 0, behavior: "smooth" });
        } else {
            overlayWrap.scrollBy({ left: 120, behavior: "smooth" });
        }
    }

    // বামে স্ক্রল
    if (dir < 0) {
        // যদি শুরুতে পৌঁছে যায় → শেষে নিয়ে যাও
        if (overlayWrap.scrollLeft <= 5) {
            overlayWrap.scrollTo({ left: maxScroll, behavior: "smooth" });
        } else {
            overlayWrap.scrollBy({ left: -120, behavior: "smooth" });
        }
    }
}


